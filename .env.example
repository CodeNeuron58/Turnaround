# Turnaround — copy to .env and fill in. Never commit .env.

# --- Gemma 4 (local inference on the GPU Droplet, OpenAI-compatible endpoint) ---
GEMMA_BASE_URL=http://localhost:11434/v1
GEMMA_MODEL=gemma4

# --- TabPFN prediction service ---
PREDICTION_SERVICE_URL=http://localhost:8000

# --- Temporal (safety timer) ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=turnaround-trips

# --- Escalation email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=

# --- Piper TTS ---
PIPER_BIN=
PIPER_VOICE=
