# Turnaround — copy to .env and fill in. Never commit .env.
# Read by the prediction service, the safety-timer worker and the agent CLI.
# Everything is optional: the defaults in code already work on one machine.
# Uncomment a line only to override it.

# --- Gemma 4 (local inference via Ollama, OpenAI-compatible endpoint) ---
# GEMMA_BASE_URL=http://localhost:11434/v1
# GEMMA_MODEL=gemma4:e4b

# --- TabPFN prediction service ---
# PREDICTION_SERVICE_URL=http://127.0.0.1:8000
# TABPFN_MODEL_PATH=data/models/tabpfn-v3.5-20260909.safetensors  (default: fast v2 checkpoint)
# TABPFN_CONTEXT_ROWS=2000
# TABPFN_N_ESTIMATORS=6
# TURNAROUND_DB=data/trips.db

# --- Piper TTS ---
# PIPER_BIN=tools/piper-bin/piper/piper.exe
# PIPER_VOICE=tools/piper/voice/en_US-amy-medium.onnx

# --- Temporal (safety timer; service starts timers + sends check-ins) ---
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_TASK_QUEUE=turnaround-trips
# LATE_WINDOW_HOURS=6
# ALERT_GRACE_MIN=30   (minutes after P95 + breaks before the contact is emailed)

# --- Alert emails via Brevo (free tier, no domain needed) ---
# Without a key, alerts are only written to workflows/outbox/.
# Check your setup: npm run test-email -w @turnaround/workflows -- you@example.com
# BREVO_API_KEY=xkeysib-...
# BREVO_SENDER_EMAIL=you@example.com   (the sender you verified in Brevo)
# BREVO_SENDER_NAME=Turnaround
